# Used by the Next.js webapp (src/lib/notion.ts) to read job listings from
# Notion. Create an integration at notion.so/my-integrations, then share the
# "Job Search" page with it.
NOTION_API_KEY=

# The Job Listings data source ID (not the database ID — see the <data-source>
# URL returned when the database was created)
NOTION_DATA_SOURCE_ID=fa5209fd-9b4e-49fe-bfbe-f6f3fbc0c69f

# The Job Inbox data source ID — raw items land here from the rss.app webhook
NOTION_INBOX_DATA_SOURCE_ID=0c47226a-b5f5-45e2-9864-e8f882893535

# HMAC-SHA256 signing secret from the rss.app webhook config. Requests
# without a valid RSSApp-Signature header are rejected. Leave unset to skip
# verification (not recommended once deployed).
RSS_APP_WEBHOOK_SECRET=

# Bearer token Vercel Cron sends when invoking /api/cron/* routes. Set this
# to any random secret in the Vercel dashboard — Vercel automatically adds
# it as an Authorization header on its own Cron requests once the env var
# exists. Leave unset to skip verification (not recommended once deployed).
CRON_SECRET=
